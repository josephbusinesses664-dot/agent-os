# ===========================================================================
# Agent OS — environment configuration
# Copy to `.env` and fill in what you need. Secrets are NEVER committed.
# The system runs fully offline with the EchoProvider when no keys are set.
# ===========================================================================

# --- Identity ---------------------------------------------------------------
AGENT_OS_NAME=Agent OS
AGENT_OS_ORG=prem-ium.inc
ENVIRONMENT=development          # development | production

# --- Persistence ------------------------------------------------------------
# Leave empty for the in-memory store (data resets on restart).
# Docker compose sets these automatically.
# DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos
# REDIS_URL=redis://localhost:6379/0
WORKSPACE_DIR=./workspace        # sandboxed file area for agents

# --- Mattermost (the human interface) ---------------------------------------
# MATTERMOST_URL=https://chat.example.com
# MATTERMOST_TOKEN=your-personal-access-token
MATTERMOST_TEAM=ai-agency
MATTERMOST_CHANNEL=town-square
MATTERMOST_POLL_INTERVAL=10
MATTERMOST_ENABLED=true

# --- Model providers --------------------------------------------------------
# Default provider when several are configured: echo | deepseek | anthropic | glm
DEFAULT_PROVIDER=echo
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GLM_API_KEY=...
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_COMPAT_API_KEY=...            # any OpenAI-compatible endpoint
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1   # e.g. local models

# --- Budgets (USD) ----------------------------------------------------------
GLOBAL_BUDGET_MONTHLY=100.0
GLOBAL_BUDGET_DAILY=20.0
DEFAULT_PROJECT_BUDGET=25.0
AUTO_DOWNGRADE_ON_BUDGET=true

# --- Agent spawning limits --------------------------------------------------
MAX_AGENT_DEPTH=4
MAX_PARALLEL_AGENTS=8
MAX_TASK_RETRIES=3
MAX_TASK_SECONDS=1800
DEFAULT_MAX_SUBAGENTS=4

# --- Memory -----------------------------------------------------------------
MEMORY_FACT_TTL_DAYS=30           # consolidation: archive stale facts after this

# --- Evaluation / performance -----------------------------------------------
EVAL_JUDGE_TIER=t3                # model tier used by the LLM-as-judge evaluator
EVAL_SETS_DIR=./eval_sets
PERF_MIN_RUNS_FOR_INFLUENCE=3     # runs before stats shape routing/delegation

# --- Tools ------------------------------------------------------------------
TOOL_RETRY_TRANSIENT=2            # retries for transient tool failures
BROWSER_TIMEOUT_MS=15000          # per-page timeout for the browser session
# GITHUB_TOKEN=ghp_...            # read-only GitHub adapter (search_repos/get_repo/list_issues)
# POSTGRES_QUERY_URL=postgresql://user:pass@host/db   # read-only SELECT adapter (approval-gated)

# --- Security ---------------------------------------------------------------
REQUIRE_APPROVAL_RISK=high       # low | medium | high
ADMIN_USER_IDS=                  # comma-separated Mattermost user ids

# --- Operations -------------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8300
WORKER_POLL_INTERVAL=2